generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Item {
  id               String            @id @default(cuid())
  itemId           Int               @unique @map("item_id")
  name             String
  quality          String
  category         String
  subCategory      String            @map("sub_category")
  icon             String?           // in-game icon texture name (e.g. "inv_staff_13"); set from addon scans
  vendorPrice      Int               @default(0) @map("vendor_price") // NPC sell price in copper; 0 = unsellable
  // NPC 卖给玩家的单价（商人卖出价，copper；0 = NPC 不卖）。来源：游戏内
  // 商人窗口 GetMerchantItemInfo(i) 的 price/quantity（M4.2 VendorPrice.lua）。
  // 配方材料成本兜底用：无 AH 价时，材料成本 = NPC 卖价（最坏可买成本），
  // 优于用收购价兜底（收购价会低估成本、虚高利润）。
  sellPrice        Int               @default(0) @map("sell_price")
  // 流通分：该物品作为材料被多少个配方使用。越高表示需求越广、周转越快。
  turnoverScore    Int               @default(0) @map("turnover_score")
  // 是否为 NPC 商人常驻出售的容器/耗材（空瓶/铅瓶/水晶瓶/染料/细线等）。
  // 这类物品拍卖行价不会超过 NPC 价，不适合捡漏。
  isVendorItem     Boolean           @default(false) @map("is_vendor_item")
  snapshots        AuctionSnapshot[]
  dailySummaries   DailySummary[]
  tiers            AuctionTier[]
  watchlistEntry   Watchlist?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([category, subCategory])
}

model AuctionSnapshot {
  id          String   @id @default(cuid())
  itemId      Int      @map("item_id")
  timestamp   DateTime
  server      String
  faction     String
  market      String   @default("faction") // "faction" (主城阵营市场) | "neutral" (中立地精市场)；中立扫描不得进入联盟分析
  source      String   @default("addon") // data channel: "addon" (game scan) — website channel removed
  minPrice    BigInt   @map("min_price")
  marketPrice BigInt   @map("market_price")
  altPrice    BigInt?  @map("alt_price") // display-only P50 close from the same scan; NULL on pre-P50 rows
  quantity    Int
  numAuctions Int      @map("num_auctions")
  rawPayload   Json?    @map("raw_payload")
  item        Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@index([itemId, timestamp])
  @@index([server, faction, market, timestamp, source])
}

model DailySummary {
  id         String   @id @default(cuid())
  itemId     Int      @map("item_id")
  date       DateTime
  source     String   @default("addon") // data channel, mirrors AuctionSnapshot.source
  server     String   @default("eu") // "eu" (欧服/默认主服) | "cn" (中国服)；双服数据严格分服，严禁混查
  market     String   @default("faction") // "faction" (主城阵营市场) | "neutral" (中立地精市场)；中立 daily 不得进入联盟分析
  openPrice  BigInt   @map("open_price")
  closePrice BigInt   @map("close_price")
  highPrice  BigInt   @map("high_price")
  lowPrice   BigInt   @map("low_price")
  volume     Int
  item       Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@unique([itemId, date, source, market, server])
  @@index([date])
  @@index([market])
  @@index([server])
}

// M4：转录插件（WoWderhoiAH-Transcript）落盘的完整价格档位——单次扫描内
// 每个单价档位一行（同价合并）。网页端据此做"稀薄+断层"钓单过滤（tier-filter），
// 得到有效最低价，并聚合成 transcript 源 DailySummary（每日代表价）。
model AuctionTier {
  id      String   @id @default(cuid())
  itemId  Int      @map("item_id")
  ts      DateTime // 扫描时间戳（插件 GetServerTime）
  server  String
  faction String
  market  String   @default("faction")
  source  String   @default("transcript")
  price   BigInt   @map("price") // 档位单价（铜）
  qty     Int                 // 该档在售量
  item    Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@index([itemId, ts])
  @@index([ts])
}

// Single-operator local terminal: no userId columns anywhere.
model Watchlist {
  id        String   @id @default(cuid())
  itemId    Int      @unique @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")
  item      Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
}

// 购物清单（2026-10-15 用户需求）：一组物品搜索词的集合，生成 Auctionator
// 可导入文本（"清单名^物品1^物品2"，Import 粘贴即建清单）。清单以名称
// （搜索词，优先基础名）为唯一键，itemId 尽量匹配 Item 表（未知/占位可空）。
model ShoppingList {
  id        String            @id @default(cuid())
  name      String            @unique // 清单名（同时是 Auctionator 导入后的清单名）
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  items     ShoppingListItem[]
}

model ShoppingListItem {
  id        String       @id @default(cuid())
  listId    String       @map("list_id")
  list      ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name      String // 搜索词（显示名/基础名快照）
  itemId    Int?         @map("item_id") // 尽量匹配的 Item.item_id；未知名称/占位为 null
  quantity  Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([listId, name])
  @@index([itemId])
}

// Route-2 authority mirror: the in-game options panel owns the deal-radar
// thresholds; each scan import replays them here so the terminal renders
// deals with the same rules the addon used. Single row (id = 1).
model RadarRule {
  id        Int      @id @default(autoincrement())
  rules     Json
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Terminal-level settings (key-value). The website-channel toggle lived here
// until the channel was removed; the table stays for future terminal settings.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Trading ledger (Stage D): our own buy/sell/expired fills uploaded from the
// addon. uid comes from the addon and lets the importer dedup on repeat scans.
// itemId is stored without a hard FK so a fill for an item we never scanned
// still lands; joins to Item at read time for name/icon.
model TradeRecord {
  id        String   @id @default(cuid())
  uid       String   @unique
  kind      String   // "buy" | "sell" | "expired"
  itemId    Int      @map("item_id")
  qty       Int
  unitPrice BigInt   @map("unit_price") // copper per unit, avg
  total     BigInt   // copper total
  ts        DateTime
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId])
  @@index([ts])
  @@index([kind])
}

// Crafting recipes dumped by the in-game /wahrecipes command (P0-B). The
// client never exposes a spell id from the trade-skill window, so the
// composite (name, profession) is the identity: re-scans upsert over the
// same key (idempotent, "重复扫描覆盖同名配方"). reagents/outputs keep the
// same key (idempotent, "重复扫描覆盖同名配方"). reagents/outputs keep the
// addon's field names (itemId/name/quantity/vendorP) so the terminal's
// profit engine can price every craft from the live market with the vendor
// floor as fallback. skillLevel is the character's current skill rank at
// dump time (display only; recipes are not filtered by learnability).
model Recipe {
  id         String   @id @default(cuid())
  name       String
  profession String
  skillLevel Int      @default(0) @map("skill_level")
  // 来源分类："craft" = 专业配方（/wahrecipes 扫描 + foreverchanges 核对），
  // "merchant" = 商人青睐兑换（集市商人，材料+青睐货币 → 成品）。
  category   String   @default("craft")
  // 商人兑换的青睐货币成本（currency id 3402）；专业配方为 0。
  favorCost  Int      @default(0) @map("favor_cost")
  // 附加信息（扫描配方无）：技能四档难度 [学,黄,绿,灰]、
  // 分类名（如"药水""药剂"）、配方/兑换法术 ID。
  difficulty Json?
  categoryName String? @map("category_name")
  spellId    Int?     @map("spell_id")
  reagents   Json
  outputs    Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([name, profession, category])
}

// Auctionator 挂单历史（AUCTIONATOR_POSTING_HISTORY，用户 2026-10-13 采纳的"账本口子"）。
// 记录自己在拍卖行的挂单行为（Auctionator 语义，非邮箱成交账本）；游戏内当前为空，
// 导入端先保留解析能力，等积累后可做轻量"我的挂单记录"页。无页面依赖，仅导入端写入。
model PostingRecord {
  id        String   @id @default(cuid())
  uid       String   @unique // Auctionator 挂单事件的唯一键
  itemId    Int      @map("item_id")
  qty       Int
  unitPrice BigInt   @map("unit_price")
  total     BigInt
  kind      String // 挂单事件类型（Auctionator 语义，如 sold/cancelled/bought）
  ts        DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId])
  @@index([ts])
}